# -----------------------------------------------------------------------
# keenchic-API-Gateway — environment variable template
# Copy to .env and fill in values. Never commit .env to version control.
# -----------------------------------------------------------------------

# Required: static API key checked on every protected endpoint (X-API-KEY header)
KEENCHIC_API_KEY=

# Backend selection for inference engine
# Options: GPU (TensorRT, auto-fallback to OpenVINO if unsupported), CPU (OpenVINO only), AUTO
KEENCHIC_BACKEND=GPU

# Optional: absolute path to a directory for saving raw uploaded images
# Leave empty to disable
KEENCHIC_UPLOAD_DIR=

# Logging output format: text or json. All application logs are written to stdout.
LOG_FORMAT=text

# Logging level: DEBUG, INFO, WARNING, or ERROR.
# DEBUG adds sanitized payload fields to the grouped http.request/http.response
# events after the Uvicorn access log. Credential and image fields are redacted,
# file bytes are never logged, and payload previews are capped at 256 KiB.
# Configure retention and access control in the external log collector.
LOG_LEVEL=INFO
