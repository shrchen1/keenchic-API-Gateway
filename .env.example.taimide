# -----------------------------------------------------------------------
# keenchic-API-Gateway — Taimide Edition Production Environment Settings
# -----------------------------------------------------------------------

# [REQUIRED] Static API key used for X-API-KEY header validation
KEENCHIC_API_KEY=

# Inference backend (GPU, CPU, or AUTO)
# Standard production server with GPU should use GPU. Use CPU for OpenVINO-only.
KEENCHIC_BACKEND=GPU

# [REQUIRED FOR TAIMIDE] Absolute path to the directory containing template files (.xlsx and .json) for download
KEENCHIC_TAIMIDE_TEMPLATE_DIR=

# [REQUIRED FOR TAIMIDE] Base directory for Taimide uploads (will contain photos/ and reports/ subdirectories)
KEENCHIC_TAIMIDE_UPLOAD_DIR=

# [OPTIONAL] Directory to save incoming uploaded images for standard inspect API (optional)
KEENCHIC_UPLOAD_DIR=

# Edition setting: Must be taimide
KEENCHIC_EDITION=taimide

# Logging Configuration
# Set to 'json' in production for structured logging compatible with ELK, Fluentd, etc.
LOG_FORMAT=json
LOG_LEVEL=INFO
